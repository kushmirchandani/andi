# Copy to .env for local dev (npm run dev loads it automatically), or set these as Fly secrets.
# Every sponsor is optional: missing keys fall back to a local implementation (see GET /health).

PORT=8080
PUBLIC_URL=http://localhost:8080
DATA_DIR=./data
APP_TIMEZONE=America/New_York
LOG_LEVEL=info
# Demo + red-team routes. In production (NODE_ENV=production) they're OFF unless these are set.
DEMO_KEY=change-me
AGENT_TEST_KEY=change-me
# No proactive nudges or milestone texts between these local hours (replies are never delayed).
QUIET_START_HOUR=2
QUIET_END_HOUR=9

# Claude (Andi's brain)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Photon V2 (Beta): project ID starts with pho_prj_, project API key with pho_sk_
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# The iMessage number people text ("hi andi <code>"). Shown in the app.
PHOTON_AGENT_HANDLE=+1XXXXXXXXXX
PHOTON_API_VERSION=2026-07-01
# Voice-capable Photon number (Voice -> Lines), connected to ElevenLabs over SIP.
PHOTON_VOICE_NUMBER=+17402558913

# Capital One Nessie
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com

# Chalk (live risk score). Client credentials from Settings > Access tokens.
# Engine URL and environment are discovered from the token response when left empty.
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_API_SERVER=https://api.chalk.ai
CHALK_ENGINE_URL=
CHALK_ENVIRONMENT_ID=

# ElevenLabs voice agent on the Photon voice number ("call your person" + inbound calls)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# The imported SIP-trunk number's id in ElevenLabs (Phone Numbers)
ELEVENLABS_PHONE_NUMBER_ID=
# Shared secret ElevenLabs sends as the x-andi-secret header to /elevenlabs/* webhooks
ELEVENLABS_WEBHOOK_SECRET=

# Optional: Find My locations via Photon's Advanced iMessage SDK (line address host:port + bearer token)
FINDMY_IMESSAGE_ADDRESS=
FINDMY_IMESSAGE_TOKEN=

# Daytona (red team + tuning scripts only; not used by the server)
DAYTONA_API_KEY=
ANDI_URL=https://andi-backend.fly.dev
