# Copy to .env for local dev (npm run dev loads it automatically), or set these as Fly secrets.
# Every sponsor is optional: missing keys fall back to a local implementation (see GET /health).

PORT=8080
PUBLIC_URL=http://localhost:8080
DATA_DIR=./data
APP_TIMEZONE=America/New_York
LOG_LEVEL=info
# Demo + red-team routes. In production (NODE_ENV=production) they're OFF unless these are set.
DEMO_KEY=change-me
AGENT_TEST_KEY=change-me
# Default quiet hours (local time): no proactive nudges or milestone texts. People can change theirs in the app.
QUIET_START_HOUR=2
QUIET_END_HOUR=9

# Claude (Andi's brain)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Photon V2 (Beta): project ID starts with pho_prj_, project API key with pho_sk_
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# The iMessage number people text ("hi andi <code>"). Shown in the app.
PHOTON_AGENT_HANDLE=+1XXXXXXXXXX
PHOTON_API_VERSION=2026-07-01
# Voice-capable Photon number (Voice -> Lines), connected to ElevenLabs over SIP.
PHOTON_VOICE_NUMBER=+13058108482

# Capital One Nessie
# Capital One Nessie v2: key from https://v2.nessieisreal.com/account (sign in with GitHub).
# The server registers its own purchase webhook at PUBLIC_URL/nessie/webhook on boot (needs public https).
NESSIE_API_KEY=
NESSIE_BASE_URL=https://v2-prod-api.nessieisreal.com

# Chalk (live risk score). Client credentials from Settings > Access tokens.
# Engine URL and environment are discovered from the token response when left empty.
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_API_SERVER=https://api.chalk.ai
CHALK_ENGINE_URL=
CHALK_ENVIRONMENT_ID=

# ElevenLabs voice agent on the Photon voice number ("call your person" + inbound calls)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# The imported SIP-trunk number's id in ElevenLabs (Phone Numbers)
ELEVENLABS_PHONE_NUMBER_ID=
# Shared secret ElevenLabs sends as the x-andi-secret header to /elevenlabs/* webhooks
ELEVENLABS_WEBHOOK_SECRET=
# Optional: iMessage voice notes in Andi's voice (milestones, or when someone asks). Same API key.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
VOICE_NOTES_PER_DAY=3

# Optional: Find My locations via Photon's Advanced iMessage SDK (line address host:port + bearer token)
FINDMY_IMESSAGE_ADDRESS=
FINDMY_IMESSAGE_TOKEN=

# Daytona (red team + tuning scripts only; not used by the server)
DAYTONA_API_KEY=
ANDI_URL=https://andi-tdc-backend.fly.dev

# Andi Gym (npm run gym; not used by the server). Optional overrides.
# GYM_MARGIN=3                     # helpfulness points (0-100) a candidate playbook must gain to be promoted
# GYM_COACH_MODEL=claude-opus-5-5  # the coach when FACTORY_API_KEY is empty

# Factory Droid SDK (nightly safety autofix: npm run autofix; not used by the server)
FACTORY_API_KEY=

# Paused: the hardware chip (docs/PAUSED.md). Off unless "1"; the code stays so it can come back.
FEATURE_CHIP=
